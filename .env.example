# Copy to .env.local for local development. Never commit real secrets.
# Supabase is optional until authentication/database features are wired.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional AI providers. Leave blank to keep demo mode and avoid API usage.
# Do not add a real key until the specific provider and budget are approved.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
# SpicyAPI remains disabled until exact checkout total and pilot spend are separately approved.
# Never expose SPICYAPI_API_KEY or SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_ prefixes.
SPICYAPI_API_KEY=
SPICYAPI_LIVE_CALLS_ENABLED=false
SPICYAPI_PURCHASE_APPROVAL_ID=
SPICYAPI_SPEND_LEDGER_READY=false
SPICYAPI_PILOT_SPEND_LIMIT_USD=10
SPICYAPI_MONTHLY_SPEND_LIMIT_USD=50
SPICYAPI_CHAT_MODEL=spicy-companion-1-flash
SPICYAPI_IMAGE_MODEL=spicy-image-1
SPICYAPI_VOICE_MODEL=spicy-voice-2
SPICYAPI_VOICE_ID=Eva
SPICYAPI_VIDEO_MODEL=spicy-motion-3



# Required server-side Supabase credentials for auth, adult verification and usage ledger.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
